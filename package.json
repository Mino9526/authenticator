{
  "name": "totp-authenticator",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Desktop TOTP authenticator with Tauri 2 and SQLite persistence.",
  "author": "Mino9526",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "tauri": "tauri",
    "start": "tauri dev",
    "dist:win": "tauri build --target x86_64-pc-windows-msvc --no-bundle",
    "dist:win:wsl": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle -- --xwin-arch x86_64",
    "test": "node --test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "esbuild": "^0.27.7",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-sql": "^2.3.2"
  }
}
